# Archivo de ejemplo: copia este archivo como ".env" para personalizar valores locales.
# NO escribas credenciales, tokens ni datos personales reales en este repositorio.
# El archivo ".env" real está excluido por .gitignore.

# Puerto del equipo local donde se publica el servicio
HOST_PORT=8080

# Nombre del entorno de ejecución
APP_ENV=local

# Ejemplo de variable sensible (dejar siempre vacía en el repositorio)
# API_TOKEN=
